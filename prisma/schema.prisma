generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id          String     @id @default(cuid())
  name        String
  code        String     @unique
  description String?
  employees   Employee[]
  createdAt   DateTime   @default(now())
}

model Employee {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  phone        String?
  address      String?
  designation  String
  joiningDate  DateTime
  status       String      @default("Active")
  department   Department  @relation(fields: [departmentId], references: [id])
  departmentId String
  createdAt    DateTime    @default(now())
}